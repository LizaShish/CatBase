@model CatBase.DTOs.HomeInfoDTO
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/styles.css" />
</head>
<a href="/Cat/Index" class="btn btn-primary" style="margin-bottom:20px">Cats List</a>

<body>
    <header>
        <div class="container">
            <h1>Welcome to CatBase Project</h1>
            <p>Your personal database for storing cat information.</p>
        </div>
    </header>

    <section id="about">
        <div class="container">
            <h2>About the Project</h2>
            <p>
                The CatBase project allows you to store and manage information about different cats. You can add details about each cat, including its name, breed, age, and more.
                This platform helps cat lovers organize their pets and keep track of important details in a user-friendly interface.
            </p>
            <p>
                Whether you have one cat or multiple, this application helps you stay organized and never forget important information about your furry friends.
            </p>
            
            
        </div>
    </section>

    <section id="features">
        <div class="container">
            <h2>Features</h2>
            <ul>
                <li>Add new cats and manage their information.</li>
                <li>Search cats by name or breed.</li>
                <li>Update cat information easily.</li>
                <li>Delete cats from your database.</li>
            </ul>
            <h3>🐾 Random Facts About Cats:</h3>
            @if (ViewBag.RandomFacts != null && ((List<string>)ViewBag.RandomFacts).Any())
            {
                <ul>
                    @foreach (var fact in (List<string>)ViewBag.RandomFacts)
                    {
                        <li>@fact</li>
                    }
                </ul>
            }
            else
            {
                <p>Факты не найдены 😿</p>
            }
        </div>
    </section>
    
</body>
</html>