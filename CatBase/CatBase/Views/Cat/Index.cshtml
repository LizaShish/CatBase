@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model CatBase.DTOs.CatDTO
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<h1>Cat List</h1>
   
  <a href="/Cat/CreateCat" class="btn btn-primary" style="margin-bottom:20px">Add Cat</a>
  <a href="/Home/Index" class="btn btn-primary" style="margin-bottom:20px">Home</a>

  <form method="get" asp-action="Index" asp-controller="Cat">
    <input type="text" name="searchString" placeholder="Search..." value="@Model.SearchTerm" />
    <label for="pageSize">Показать:</label>
    <select name="pageSize" onchange="this.form.submit()">
        @{
            var pageSize = ViewBag.PageSize ?? 10;
        }
        <option value="5" selected="@(pageSize == 5 ? "selected" : null)">5</option>
        <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10</option>
        <option value="20" selected="@(pageSize == 20 ? "selected" : null)">20</option>
    </select>
    <button type="submit">Search</button>
 </form>
<style>
    .table td, .table th 
    {
        padding-left: 15px;
        padding-right: 15px;
    }
</style>
<table class="table">
    <thead>
        <tr>
            <th class="center-align">CatsName</th>
            <th class="center-align">Breeds</th>
            <th class="center-align">Photo</th>
            <th class="center-align">Actions</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Cats == null || !Model.Cats.Any())
        {
            <tr><td colspan="3">No data</td></tr>
        }
        @foreach (var cat in Model.Cats)
        {
            <tr>
                <td>@cat.CatsName</td>
                <td>@cat.Breeds</td> 
                <td>
                    @if (!string.IsNullOrEmpty(cat.Img))
                    {
                        <img src="@cat.Img" alt="Photo" style="width: 80px; height: 80px; object-fit: cover; border-radius: 5px;">
                    }
                    else
                    {
                        <span>Нет фото</span>
                    }
                </td>
                <td>
                    <a asp-action="Delete" asp-controller="Cat" asp-route-id="@cat.Id" class="btn btn-primary me-3">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Cat", new { page = i, searchString = Model.SearchTerm, pageSize = Model.PageSize })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
    <div class="go-up">
        <a href="#top" title="Наверх">
            <i class="fas fa-arrow-up"></i> Наверх
        </a>
    </div>
</div>



