@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model CatBase.DTOs.DeleteCatDTO
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container">

    <h1>Delete</h1>
        <div class="container">
        @if (Model != null)
        {
            <p>Are you sure you want to delete the cat "@Model.CatsName"?</p>

            <form asp-action="DeleteCat" asp-controller= "Cat" method="post">
                <input type="hidden" asp-for="Id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        }
        else
        {
            <p>Error: Cat not found.</p>
        }
        </div>
</div>